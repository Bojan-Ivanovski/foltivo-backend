# Copy to ignored .env, choose a local password, and update both entries.
# URL-encode special characters in DATABASE_URL's username/password.
APP_ENV=development
APP_ORIGIN=http://localhost:5173
HTTP_ADDR=127.0.0.1:8080
POSTGRES_DB=foltivo_development
POSTGRES_USER=foltivo
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://foltivo:replace-with-local-password@127.0.0.1:5432/foltivo_development?sslmode=disable

# Generate once: openssl rand -base64 32. Persist securely; do not commit real keys.
AUTH_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SMTP_ADDR=127.0.0.1:1025
SMTP_FROM=noreply@localhost
SMTP_REQUIRE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Production requires exact CIDRs of the actual trusted TLS proxies; empty locally.
# Example for a same-host proxy: 127.0.0.1/32,::1/128. Never trust all clients.
TRUSTED_PROXY_CIDRS=

# Optional existing-account provider linking/login. Leave every field empty to
# disable a provider. Register each exact callback in its provider application.
# Use the browser-visible origin (frontend proxy locally), never the internal API.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=
# Example GitHub callback: http://localhost:5173/api/v1/auth/providers/github/callback
# Example Google callback: http://localhost:5173/api/v1/auth/providers/google/callback
