# Copy to ignored .env, choose a local password, and update both entries.
# URL-encode special characters in DATABASE_URL's username/password.
APP_ENV=development
APP_ORIGIN=http://localhost:5173
HTTP_ADDR=127.0.0.1:8080
POSTGRES_DB=foltivo_development
POSTGRES_USER=foltivo
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://foltivo:replace-with-local-password@127.0.0.1:5432/foltivo_development?sslmode=disable

# Generate once: openssl rand -base64 32. Persist securely; do not commit real keys.
AUTH_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SMTP_ADDR=127.0.0.1:1025
SMTP_FROM=noreply@localhost
SMTP_REQUIRE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
